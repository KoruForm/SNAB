# Supabase project settings → API. Both values are public; row-level security protects the data.
# Leave them unset to run the local demo with drafts saved in the browser.
# Next.js reads NEXT_PUBLIC_ values at build time, so set them before `npm run build`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your live site address, used for link previews when SNAB is shared. Leave blank to use the Hostinger preview address.
NEXT_PUBLIC_SITE_URL=
# Address suggestions on the seller's "Where" step (app/api/address). Server-only: never prefix it with NEXT_PUBLIC_.
# Geoapify → My Projects → your project's API key. Leave blank to use the free keyless Photon service.
GEOAPIFY_API_KEY=
# Optional MapLibre style for the maps. Defaults to OpenFreeMap's free Positron style.
NEXT_PUBLIC_MAP_STYLE_URL=
# Umami Cloud website ID (Umami → Settings → Websites → Edit). Turns on visitor stats; leave blank to switch them off.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Coming soon teaser (lib/launch.ts). On by default: the home page shows the teaser and the app is hidden.
# Set to off when SNAB opens to everyone.
NEXT_PUBLIC_COMING_SOON=
# Private preview link while the teaser is on: open /?preview=<this value> to unlock the app in that browser.
# Server-only, at least 8 characters. Leave blank to switch the preview link off.
SNAB_PREVIEW_KEY=
